# Base de datos para Vercel / Producción (PostgreSQL en Supabase, Neon, Vercel Postgres, etc.)
# Ejemplo Neon/Supabase:
DATABASE_URL="postgresql://usuario:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# Si usas SQLite en desarrollo local, puedes usar:
# DATABASE_URL="file:./dev.db"

# Clave del panel /admin (cualquiera sin esta cookie es redirigido a /admin/login)
# ADMIN_PASSWORD="elegi-una-clave-larga"
